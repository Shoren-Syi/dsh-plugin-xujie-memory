{
  "name": "dsh-plugin-hippocampus-deepseek",
  "version": "0.2.0",
  "description": "DSH 插件：每轮自动记忆与注入，装上即用。记忆存本地 SQLite，不训练、不上传。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "hippo/**/*.py",
    "hippo/data/**",
    "runtime/**",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Shoren-Syi",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "hippocampus"
  ]
}
