{
  "name": "dsh-plugin-hippocampus-deepseek",
  "version": "0.2.5",
  "description": "DSH 插件：自动提取与召回对话记忆，记忆数据库存于本地 SQLite。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "hippo/**/*.py",
    "hippo/data/**",
    "runtime/**",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Shoren-Syi",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "memory",
    "hippocampus"
  ]
}
